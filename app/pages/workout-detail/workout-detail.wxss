.page {
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-6) + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; gap: var(--sp-3);
  min-height: 100vh; box-sizing: border-box;
}

/* 二级页 nav:返回钮 + 居中标题 + 对称占位 */
.nav-title-sm { font-size: var(--fs-h2); }
.nav-back-ghost { background: transparent; border: none; }

/* 完赛 hero:紫晕 + lime 完成徽章 */
/* 完赛 hero:立体紫面(与其他紫面同构) */
.hero {
  padding: var(--sp-5) var(--sp-4);
  background: linear-gradient(180deg, var(--violet-2) 0%, var(--violet) 50%, #4A21C9 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: var(--r-xl);
  box-shadow:
    inset 0 6rpx 0 rgba(255, 255, 255, 0.22),
    0 12rpx 0 var(--violet-side),
    14rpx 18rpx 0 rgba(0, 0, 0, 0.4);
}
.just-badge {
  display: inline-block; padding: 8rpx 24rpx; margin-bottom: var(--sp-3);
  background: var(--lime); color: var(--bg);
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: var(--r-pill); font-size: var(--fs-caption); font-weight: 700;
  box-shadow: 0 4rpx 0 var(--lime-side);
}
.date { color: var(--txt-2); font-size: var(--fs-caption); letter-spacing: 2rpx; }
.hero-dist { display: flex; align-items: baseline; gap: 14rpx; margin: var(--sp-2) 0 var(--sp-6); }
.hero-dist .d { font-size: var(--fs-hero); line-height: 1; color: var(--ink); letter-spacing: -4rpx; font-variant-numeric: tabular-nums; }
.hero-dist .u { color: var(--txt-2); font-size: var(--fs-caption); letter-spacing: 4rpx; }
.hero-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); margin-bottom: var(--sp-2); }
.hg { display: flex; flex-direction: column; align-items: center; }
.hg .v { font-size: var(--fs-h2); color: var(--ink); letter-spacing: -2rpx; font-variant-numeric: tabular-nums; }
.hg .l { font-size: var(--fs-micro); color: var(--txt-2); margin-top: var(--sp-1); letter-spacing: 2rpx; }

.chart { padding: var(--sp-5); border-radius: var(--r-xl); }
.chart-title { font-size: var(--fs-label); color: var(--txt-2); letter-spacing: 6rpx; margin-bottom: var(--sp-3); }
.trace { width: 100%; height: 240rpx; }
