<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight + 8}}px">
    <text class="nav-title">我的</text>
    <text class="nav-sub">SETTINGS</text>
  </view>

  <view class="sec hud-panel">
    <view class="sec-title">设备</view>
    <view class="row">
      <text class="k">连接模式</text>
      <text class="v mono">{{modeText}}</text>
    </view>
    <view class="row">
      <text class="k">设备名</text>
      <text class="v mono">MOBI000401</text>
    </view>
    <view class="row">
      <text class="k">协议</text>
      <text class="v">ChangYow FFE0(待验证)</text>
    </view>
  </view>

    <view class="row link" bindtap="openOplog">
      <text class="k">蓝牙操作日志</text>
      <text class="v">›</text>
    </view>
  </view>

  <view class="sec hud-panel">
    <view class="sec-title">功率</view>
    <view class="row">
      <text class="k">FTP(功能阈值功率)</text>
      <input class="goal-input mono" type="number"
             value="{{ftp}}" bindblur="onFTPChange"/>
      <text class="unit">W</text>
    </view>
    <view class="row">
      <text class="k">功率区间</text>
      <text class="v">Zone 1–7(Coggan)</text>
    </view>
  </view>

  <view class="sec hud-panel">
    <view class="sec-title">目标</view>
    <view class="row">
      <text class="k">单次距离目标</text>
      <input class="goal-input mono" type="number"
             value="{{goalKm}}" bindblur="onGoalChange"/>
      <text class="unit">KM</text>
    </view>
  </view>

  <view class="sec hud-panel">
    <view class="sec-title">关于</view>
    <text class="about-text">小莫已倒闭,这台机器由本项目复活。\n数据 100% 本地存储,无任何云端依赖。\n协议逆向进行中:{{protoStatus}}</text>
  </view>
</view>
