<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight + 8}}px">
    <view class="nav-back" bindtap="goBack">←</view>
    <text class="nav-title nav-title-sm">蓝牙操作日志</text>
    <text class="nav-clear" bindtap="clearAll">清空</text>
  </view>

  <view class="card hud-panel op-card" wx:if="{{list.length}}">
    <scroll-view scroll-y class="op-scroll" enhanced show-scrollbar="{{false}}">
      <view class="op-row" wx:for="{{list}}" wx:key="index">
        <text class="op-icon">{{item.icon}}</text>
        <view class="op-main">
          <text class="op-label">{{item.label}}</text>
          <text class="op-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
        </view>
        <text class="op-time mono">{{item.timeText}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">
    <text class="empty-icon">📡</text>
    <text class="empty-text">暂无操作记录\n连接、调阻、开始/结束都会记录在这里</text>
  </view>

  <view class="op-foot" wx:if="{{list.length}}">共 {{list.length}} 条 · 仅存本机,上限 500 条</view>
</view>
