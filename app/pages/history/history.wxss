.page {
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-6) + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; gap: var(--sp-2);
  min-height: 100vh; box-sizing: border-box;
}

.week { padding: var(--sp-5); border-radius: var(--r-xl); }
.week-title { font-size: var(--fs-label); color: var(--txt-2); letter-spacing: 6rpx; margin-bottom: var(--sp-3); }
.week-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); }
.week-item { display: flex; flex-direction: column; align-items: center; }
.week-item .v { font-size: var(--fs-h2); color: var(--lime); letter-spacing: -2rpx; font-variant-numeric: tabular-nums; }
.week-item .l { font-size: var(--fs-micro); color: var(--txt-2); margin-top: var(--sp-1); letter-spacing: 2rpx; }

.empty { display: flex; flex-direction: column; align-items: center; padding: var(--sp-8) 0 calc(var(--sp-8) + var(--sp-6)); }
.empty-icon { font-size: 80rpx; margin-bottom: var(--sp-3); }
.empty-text { color: var(--txt-2); text-align: center; line-height: 1.8; font-size: var(--fs-caption); }

.item {
  display: flex; justify-content: space-between; align-items: center;
  padding: var(--sp-4);
  border-radius: var(--r-xl);
  background: rgba(20, 22, 28, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(40rpx) saturate(1.3);
  -webkit-backdrop-filter: blur(40rpx) saturate(1.3);
  transition: background-color var(--dur-fast) var(--ease);
}
.item:active { background: rgba(27, 30, 38, 0.75); }
.item-date { font-size: var(--fs-body); font-weight: 700; display: block; color: var(--ink); }
.item-sub { font-size: var(--fs-caption); color: var(--txt-2); margin-top: var(--sp-1); font-variant-numeric: tabular-nums; }
.item-right { text-align: right; }
.item-dist { font-size: var(--fs-h2); color: var(--lime); letter-spacing: -2rpx; }
.item-unit { font-size: var(--fs-micro); color: var(--txt-2); display: block; margin-top: 2rpx; letter-spacing: 2rpx; }

/* 分段控件:明细/日报/月报 */
.seg {
  display: flex; gap: 6rpx; padding: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92); border-radius: var(--r-pill);
  background: var(--panel); box-shadow: 0 8rpx 0 #05070A;
}
.seg-i {
  flex: 1; text-align: center; padding: 14rpx 0;
  border-radius: var(--r-pill); color: var(--txt-2); font-size: 26rpx; font-weight: 700;
}
.seg-on { background: var(--violet); color: #fff; }
.sec-t { font-size: 22rpx; color: var(--txt-2); letter-spacing: 4rpx; margin-bottom: 20rpx; }
